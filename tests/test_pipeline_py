# ── Tests ─────────────────────────────────────────────────────────────────────

def test_risk_agent_detects_mildiu(base_state):
    state = RiskAgent().run(base_state)
    risk_types = [a.risk_type for a in state.alerts]
    assert "mildiu_risk" in risk_types


def test_risk_agent_detects_frost(frost_state):
    state = RiskAgent().run(frost_state)
    risk_types = [a.risk_type for a in state.alerts]
    assert "frost_risk" in risk_types


def test_deliberative_agent_produces_scenarios(base_state):
    state = RiskAgent().run(base_state)
    state = DeliberativeAgent().run(state, top_n=3)
    assert len(state.scenarios) > 0
    assert state.scenarios[0].utility > 0


def test_deliberative_agent_urgent_path(frost_state):
    """En ruta urgente top_n=1 produce exactamente 1 escenario."""
    state = RiskAgent().run(frost_state)
    state = DeliberativeAgent().run(state, top_n=1)
    assert len(state.scenarios) == 1


def test_critic_approves_normal_scenario(base_state):
    state = RiskAgent().run(base_state)
    state = DeliberativeAgent().run(state, top_n=3)
    result = CriticAgent().run(state)
    # En condiciones normales de verano, el crítico debe aprobar
    assert "approved" in result
    assert isinstance(result["approved"], bool)


def test_daily_plan_always_generates(base_state):
    """DailyPlanAgent siempre genera un plan, incluso sin alertas."""
    state = RiskAgent().run(base_state)
    state = DailyPlanAgent().run(state)
    assert state.daily_plan is not None
    assert state.daily_plan.irrigation.adjusted_liters >= 0


def test_routing_identifies_critical_alerts(frost_state):
    """El routing del orquestador identifica correctamente alertas críticas."""
    state = RiskAgent().run(frost_state)
    critical = [a for a in state.alerts if a.level in ("alto", "crítico")]
    assert len(critical) > 0


def test_excluded_actions_filter(base_state):
    """DeliberativeAgent respeta las acciones excluidas por el crítico."""
    state = RiskAgent().run(base_state)
    state = DeliberativeAgent().run(state, top_n=3, excluded_actions=["fungicide"])
    for scenario in state.scenarios:
        for action in scenario.actions:
            if action.type == "fungicide":
                assert action.intensity == "none", \
                    "fungicide debería estar en none cuando está excluido"
